# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/faceid_saas
DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5432/faceid_saas

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_URL=redis://localhost:6379/0

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# DeepFace
DEEPFACE_MODEL=ArcFace
DEEPFACE_DETECTOR=retinaface
DEEPFACE_DISTANCE_METRIC=cosine
ANTI_SPOOFING_ENABLED=true

# Pricing (USD)
PRICE_ENROLLMENT=0.10
PRICE_AUTH=0.02
PRICE_ANTIFAUD_ADDON=0.03

# App
APP_ENV=development
APP_VERSION=0.1.0
