# ═══════════════════════════════════════════════════════════════════════════════
#  FaceID SaaS — Variables de entorno PRODUCCIÓN
#  Copia este archivo como .env y completa todos los valores marcados con !!!
#  NUNCA subas .env a git — ya está en .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Dominio ─────────────────────────────────────────────────────────────────
# !!! Reemplaza con tu dominio real (sin https://, sin www)
DOMAIN=faceid.tudominio.com

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_VERSION=1.0.0

# ─── Seguridad ───────────────────────────────────────────────────────────────
# !!! Genera con: openssl rand -hex 32
SECRET_KEY=CAMBIA_ESTO_openssl_rand_hex_32

# ─── Base de datos ───────────────────────────────────────────────────────────
# !!! Genera con: openssl rand -base64 24 | tr -d '/+=' | head -c 32
POSTGRES_PASSWORD=CAMBIA_ESTO_password_fuerte
# Estas URLs las sobreescribe docker-compose.prod.yml — no tocar
DATABASE_URL=postgresql+asyncpg://postgres:CAMBIA_ESTO_password_fuerte@db:5432/faceid_saas
DATABASE_SYNC_URL=postgresql://postgres:CAMBIA_ESTO_password_fuerte@db:5432/faceid_saas

# ─── Redis ───────────────────────────────────────────────────────────────────
# !!! Genera con: openssl rand -hex 20
REDIS_PASSWORD=CAMBIA_ESTO_redis_password
REDIS_URL=redis://:CAMBIA_ESTO_redis_password@redis:6379/0

# ─── JWT / Portal ────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PORTAL_TOKEN_EXPIRE_HOURS=8

# ─── Stripe (billing) ────────────────────────────────────────────────────────
# !!! Obtén desde dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_REEMPLAZA_CON_TU_KEY_LIVE
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZA_CON_TU_SECRET

# ─── DeepFace / ML ───────────────────────────────────────────────────────────
DEEPFACE_MODEL=ArcFace
# yunet es rápido y preciso para producción; retinaface es más preciso pero más lento
DEEPFACE_DETECTOR=yunet
DEEPFACE_DISTANCE_METRIC=cosine
# 0.55 = equilibrado | 0.45 = estricto (menos falsos positivos) | 0.65 = permisivo
DEEPFACE_THRESHOLD=0.55
# Ratio mínimo cara/imagen — 0.35 ≈ cara debe cubrir ~9% del frame
FACE_QUALITY_MIN=0.35
# true = activa MiniFASNet anti-spoofing (detecta fotos de pantallas/fotos)
ANTI_SPOOFING_ENABLED=true

# ─── Precios (USD por operación) ─────────────────────────────────────────────
PRICE_ENROLLMENT=0.10
PRICE_AUTH=0.02
PRICE_ANTIFAUD_ADDON=0.03
PRICE_LIVENESS_CHECK=0.01

# ─── Liveness ────────────────────────────────────────────────────────────────
# true = TODOS los tenants deben enviar X-Challenge-Id en authenticate
# false = solo los tenants con liveness_required=true a nivel de tenant
LIVENESS_REQUIRED=false

# ─── CORS ────────────────────────────────────────────────────────────────────
# "*" es correcto para una API pública donde tenants integran desde sus dominios
# Si quieres restringir: "https://tudominio.com,https://app.tudominio.com"
CORS_ORIGINS=*

# ─── Uvicorn workers ─────────────────────────────────────────────────────────
# Cada worker carga ArcFace en RAM (~1.5GB por worker)
# VPS 4GB RAM → 2 workers | VPS 8GB RAM → 4 workers
API_WORKERS=2
