# ─── Base de datos ───────────────────────────────────────────────────────────
# Para desarrollo LOCAL sin Docker: usa localhost
# En Docker Compose estas URLs se sobreescriben con el nombre del servicio (db/redis)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/faceid_saas
DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5432/faceid_saas

# ─── Seguridad ───────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Stripe (billing) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REEMPLAZA_CON_TU_KEY
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZA_CON_TU_SECRET

# ─── DeepFace ────────────────────────────────────────────────────────────────
DEEPFACE_MODEL=ArcFace
DEEPFACE_DETECTOR=yunet
DEEPFACE_DISTANCE_METRIC=cosine
DEEPFACE_THRESHOLD=0.55
FACE_QUALITY_MIN=0.35
ANTI_SPOOFING_ENABLED=true

# ─── Precios (USD) ───────────────────────────────────────────────────────────
PRICE_ENROLLMENT=0.10
PRICE_AUTH=0.02
PRICE_ANTIFAUD_ADDON=0.03

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0

# Liveness — pon true en producción para exigir challenge-response antes de autenticar
# LIVENESS_REQUIRED=true  ← descomenta esta línea para forzarlo globalmente
LIVENESS_REQUIRED=true
